# =====================================================================
#  retro-go target: MICROBYTE  --  sdkconfig DEFAULTS seed
# =====================================================================
#  DRAFT  --  NOT BUILT, NOT TESTED.
#
#  HOW THIS FILE IS USED (rg_tool.py:195-196):
#      os.putenv("SDKCONFIG_DEFAULTS", abspath(targets/<t>/sdkconfig))
#  It is a *defaults seed*, not a full sdkconfig. Any key that ESP-IDF no
#  longer knows is dropped with a warning; nothing here is authoritative.
#
#  Per upstream PORTING.md the real file is produced like this, AFTER the
#  target folder exists:
#      ./rg_tool.py clean
#      ./rg_tool.py --target=microbyte build launcher
#      cd launcher && idf.py menuconfig          # verify every setting below
#      cp launcher/sdkconfig ../components/retro-go/targets/microbyte/sdkconfig
#      ./rg_tool.py clean
#
#  Values are taken from microByte's own sdkconfig where they still exist
#  in IDF 5.2, and from targets/odroid-go/sdkconfig (same silicon family:
#  ESP32-WROVER) where they don't.  RENAMED / CHANGED lines are marked.
# =====================================================================

#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

#
# Compiler options
#
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Saves ~50K of binary size. retro-go's own comment says keep assertions off.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=n
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_STACK_CHECK_MODE_NONE=y
CONFIG_NEWLIB_NANO_FORMAT=y

#
# SPI configuration
#
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

#
# ESP32-specific
#
# RENAMED in IDF 5.x: ESP32_DEFAULT_CPU_FREQ_* -> ESP_DEFAULT_CPU_FREQ_*
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_INT_WDT=y
# RENAMED in IDF 5.x: ESP_TASK_WDT -> ESP_TASK_WDT_EN
# retro-go disables the task watchdog because its emulation tasks
# intentionally hog the CPU.
CONFIG_ESP_TASK_WDT_EN=n

#
# SPI RAM (PSRAM) config
#
# RENAMED in IDF 5.x: ESP32_SPIRAM_SUPPORT -> SPIRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=32768
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# DROPPED in IDF 5.x: SPIRAM_SIZE, SPIRAM_CACHE_WORKAROUND, SPIRAM_BANKSWITCH_ENABLE
#
# Mirrors microByte's own value. On a 32Mbit PSRAM running at 80MHz this
# would hand HSPI to the PSRAM clock and break the LCD (which is on HSPI)  -- 
# microByte runs its LCD on HSPI with this option set and works, which
# proves the module's PSRAM is 64Mbit and this option is inert here.
CONFIG_SPIRAM_OCCUPY_HSPI_HOST=y

#
# FAT Filesystem support
#
CONFIG_FATFS_CODEPAGE_437=y
CONFIG_FATFS_CODEPAGE=437
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# microByte builds with ANSI_OEM; retro-go's launcher needs UTF-8 for ROM names.
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_FASTSEEK=y

#
# FreeRTOS
#
CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_PTRVAL=y
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1024
CONFIG_FREERTOS_CHECK_MUTEX_GIVEN_BY_OWNER=n

#
# Log output
#
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_LOG_COLORS=y

#
# Legacy driver warnings
#
# retro-go still uses the deprecated legacy ADC and I2S drivers; without
# these two the build is a wall of deprecation warnings.
CONFIG_ADC_SUPPRESS_DEPRECATE_WARN=y
CONFIG_I2S_SUPPRESS_DEPRECATE_WARN=y

#
# TLS / HTTP (needed by retro-go's GitHub release check)
#
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

#
# Wi-Fi
#
# RENAMED in IDF 5.x: ESP32_WIFI_* -> ESP_WIFI_*
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

#
# SPI Flash driver
#
CONFIG_SPI_FLASH_ENABLE_ENCRYPTED_READ_WRITE=n

#
# Partition table
#
# rg_tool.py writes a throwaway partitions.csv next to each app and points
# these at "../partitions.csv"; it is never flashed. The real device layout
# comes from tools/mkfw.py at image-packing time.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="../partitions.csv"
CONFIG_PARTITION_TABLE_MD5=n
